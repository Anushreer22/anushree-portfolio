# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL connection string)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_db?schema=public"

# Security & CORS
# Comma-separated list of allowed frontend origins (e.g. local Vite dev server and deployed frontend)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,https://your-portfolio.vercel.app"

# JWT Authentication for Admin Access
# Generate a strong 32+ character random secret for production
JWT_SECRET="replace-with-a-very-secure-random-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="1h"

# Resend Email Service Configuration
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY="re_placeholder_api_key"

# Email Notification Routing
# CONTACT_FROM_EMAIL must be a verified domain on Resend, or 'onboarding@resend.dev' for sandbox testing
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
CONTACT_TO_EMAIL="anushreer695@gmail.com"

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_CONTACT_MAX=5
RATE_LIMIT_AUTH_MAX=5

# Optional Admin Credentials for Database Seeding (First-time setup)
INITIAL_ADMIN_EMAIL="admin@anushreer.dev"
INITIAL_ADMIN_PASSWORD="ChangeThisPassword123!"
INITIAL_ADMIN_NAME="Anushree R"

